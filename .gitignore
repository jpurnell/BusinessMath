!.swift-version
!.swiftpm/

# Build artifacts
.build/
xcuserdata/
Package.resolved

# SwiftPM - ignore user-specific data but keep shared workspace/schemes for CI
.swiftpm/xcode/package.xcworkspace/xcuserdata/
.swiftpm/configuration/

# Internal documentation and planning
Blog/
Site/
Playgrounds/
development-guidelines/
Sources/BusinessMath/zzz In Process/
investmentOpportunity.md

# `scripts/` was ignored here to drop a long-removed `scripts/update_readme.sh`.
# On a case-insensitive filesystem that pattern also swallowed `Scripts/`, which
# holds `reference-fixtures/` — the generators behind every committed oracle
# fixture. CHANGELOG.md and project/master_plan.md both cite that directory as
# part of the repository; it had never been in it, so no fixture could be
# regenerated or audited from a clean clone. Ignore the noise instead of the
# directory.
Scripts/**/__pycache__/
Scripts/**/*.pyc
Scripts/**/.venv/

# Temporary and backup files
*~
\#*\#
*.bundle
*.bak
howToResume.md
overallRules

