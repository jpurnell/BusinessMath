#!/usr/bin/env swift

import Foundation

// MARK: - Swift Documentation Gap Analyzer
// A generic tool to find public APIs without documentation comments
// Usage: swift-doc-gaps [path] [--json output.json] [--verbose]

// MARK: - Configuration

struct Config {
    let projectPath: String
    let sourcesDir: String
    let jsonOutput: String?
    let verbose: Bool

    static func parse() -> Config {
        var args = Array(CommandLine.arguments.dropFirst())
        var projectPath = FileManager.default.currentDirectoryPath
        var jsonOutput: String? = nil
        var verbose = false

        // Parse flags
        while let index = args.firstIndex(where: { $0.hasPrefix("--") || $0.hasPrefix("-") }) {
            let flag = args.remove(at: index)
            switch flag {
            case "--json", "-j":
                if index < args.count {
                    jsonOutput = args.remove(at: index)
                }
            case "--verbose", "-v":
                verbose = true
            case "--help", "-h":
                printUsage()
                exit(0)
            default:
                print("Unknown flag: \(flag)")
                printUsage()
                exit(1)
            }
        }

        // Remaining arg is project path
        if let path = args.first {
            projectPath = (path as NSString).expandingTildeInPath
            if !projectPath.hasPrefix("/") {
                projectPath = FileManager.default.currentDirectoryPath + "/" + projectPath
            }
        }

        // Find Sources directory
        let sourcesDir = findSourcesDirectory(in: projectPath)

        return Config(
            projectPath: projectPath,
            sourcesDir: sourcesDir,
            jsonOutput: jsonOutput,
            verbose: verbose
        )
    }

    static func printUsage() {
        print("""
        swift-doc-gaps - Find undocumented public APIs in Swift projects

        USAGE:
            swift-doc-gaps [path] [options]

        ARGUMENTS:
            path                Path to Swift package/project (default: current directory)

        OPTIONS:
            -j, --json FILE     Export results to JSON file
            -v, --verbose       Show detailed output
            -h, --help          Show this help message

        EXAMPLES:
            swift-doc-gaps                           # Analyze current directory
            swift-doc-gaps ~/Projects/MyApp          # Analyze specific project
            swift-doc-gaps . --json gaps.json        # Export to JSON
            swift-doc-gaps ~/Projects/MyApp -v       # Verbose output
        """)
    }
}

func findSourcesDirectory(in projectPath: String) -> String {
    let fm = FileManager.default

    // Common Swift project structures
    let candidates = [
        "\(projectPath)/Sources",
        "\(projectPath)/Source",
        "\(projectPath)/src",
        projectPath  // Fallback to root
    ]

    for candidate in candidates {
        var isDir: ObjCBool = false
        if fm.fileExists(atPath: candidate, isDirectory: &isDir) && isDir.boolValue {
            // Check if it contains Swift files
            if let contents = try? fm.contentsOfDirectory(atPath: candidate) {
                let hasSwiftContent = contents.contains { item in
                    item.hasSuffix(".swift") ||
                    (try? fm.contentsOfDirectory(atPath: "\(candidate)/\(item)"))?.contains { $0.hasSuffix(".swift") } == true
                }
                if hasSwiftContent {
                    return candidate
                }
            }
        }
    }

    return projectPath
}

// MARK: - Data Structures

struct UndocumentedAPI {
    let file: String
    let lineNumber: Int
    let apiType: String
    let name: String
    let declaration: String
}

// MARK: - Extraction Helpers

func extractFunctionName(from line: String) -> String {
    guard let funcRange = line.range(of: "func ") else { return "unknown" }
    let afterFunc = line[funcRange.upperBound...]

    let endChars = CharacterSet(charactersIn: "(<")
    if let endRange = afterFunc.rangeOfCharacter(from: endChars) {
        return String(afterFunc[..<endRange.lowerBound]).trimmingCharacters(in: .whitespaces)
    }
    return String(afterFunc).trimmingCharacters(in: .whitespaces)
}

func extractTypeName(from line: String, keyword: String) -> String {
    guard let keywordRange = line.range(of: keyword) else { return "unknown" }
    let afterKeyword = line[keywordRange.upperBound...]

    let endChars = CharacterSet(charactersIn: ":{<")
    if let endRange = afterKeyword.rangeOfCharacter(from: endChars) {
        return String(afterKeyword[..<endRange.lowerBound]).trimmingCharacters(in: .whitespaces)
    }
    return String(afterKeyword).trimmingCharacters(in: .whitespaces)
}

func extractPropertyName(from line: String, keyword: String) -> String {
    guard let keywordRange = line.range(of: keyword) else { return "unknown" }
    let afterKeyword = line[keywordRange.upperBound...]

    let endChars = CharacterSet(charactersIn: ":={")
    if let endRange = afterKeyword.rangeOfCharacter(from: endChars) {
        return String(afterKeyword[..<endRange.lowerBound]).trimmingCharacters(in: .whitespaces)
    }
    return String(afterKeyword).trimmingCharacters(in: .whitespaces)
}

// MARK: - File Discovery

func findSwiftFiles(in directory: String) -> [String] {
    let fm = FileManager.default
    var files: [String] = []

    guard let enumerator = fm.enumerator(atPath: directory) else { return [] }

    while let file = enumerator.nextObject() as? String {
        // Skip build directories and hidden files
        if file.contains(".build") || file.contains("/.") || file.hasPrefix(".") {
            continue
        }
        if file.hasSuffix(".swift") {
            files.append("\(directory)/\(file)")
        }
    }

    return files.sorted()
}

// MARK: - Analysis

/// Determines if a line index is inside a documentation block comment (/** ... */)
/// or inside a code fence within a doc comment. Returns true if the line should be skipped.
func isInsideDocBlock(lineIndex: Int, lines: [String]) -> Bool {
    var inBlockComment = false
    var inCodeFence = false

    for i in 0..<lineIndex {
        let stripped = lines[i].trimmingCharacters(in: .whitespacesAndNewlines)

        // Track block comment start/end
        if stripped.contains("/**") && !stripped.contains("*/") {
            inBlockComment = true
            inCodeFence = false  // Reset code fence tracking when entering new block
        }
        if stripped.contains("*/") {
            inBlockComment = false
            inCodeFence = false
        }

        // Track code fences within block comments
        if inBlockComment && stripped.hasPrefix("```") {
            inCodeFence = !inCodeFence
        }
    }

    return inBlockComment || inCodeFence
}

/// Checks if a line has documentation by looking backwards through attributes
func hasDocumentation(lineIndex: Int, lines: [String]) -> Bool {
    var lookbackIndex = lineIndex - 1

    while lookbackIndex >= 0 {
        let prevLine = lines[lookbackIndex].trimmingCharacters(in: .whitespacesAndNewlines)

        // Found doc comment - has documentation
        if prevLine.hasPrefix("///") || prevLine.hasPrefix("/**") || prevLine.hasSuffix("*/") {
            return true
        }

        // Skip over attributes (@available, @MainActor, etc.)
        if prevLine.hasPrefix("@") {
            lookbackIndex -= 1
            continue
        }

        // Skip over empty lines
        if prevLine.isEmpty {
            lookbackIndex -= 1
            continue
        }

        // Skip over access modifiers on their own line
        if prevLine.hasPrefix("public") || prevLine.hasPrefix("private") ||
           prevLine.hasPrefix("internal") || prevLine.hasPrefix("open") ||
           prevLine.hasPrefix("fileprivate") {
            lookbackIndex -= 1
            continue
        }

        // Skip over compiler directives
        if prevLine.hasPrefix("#") {
            lookbackIndex -= 1
            continue
        }

        // Any other content means no doc comment found
        break
    }

    return false
}

func analyzeFile(_ filePath: String, relativeTo basePath: String, verbose: Bool) -> (apis: [UndocumentedAPI], totalPublic: Int) {
    guard let content = try? String(contentsOfFile: filePath, encoding: .utf8) else {
        return ([], 0)
    }

    var undocumented: [UndocumentedAPI] = []
    var totalPublic = 0

    let lines = content.components(separatedBy: "\n")
    let relativePath = filePath.replacingOccurrences(of: basePath + "/", with: "")

    for (index, line) in lines.enumerated() {
        let lineNumber = index + 1
        let trimmed = line.trimmingCharacters(in: .whitespacesAndNewlines)

        // Skip non-public declarations
        guard trimmed.hasPrefix("public ") else { continue }

        // Skip if this line is inside a documentation block (e.g., code example)
        if isInsideDocBlock(lineIndex: index, lines: lines) {
            continue
        }

        totalPublic += 1

        // Check if previous lines have documentation
        let hasDocs = hasDocumentation(lineIndex: index, lines: lines)

        if !hasDocs {
            var apiType = "other"
            var name = "unknown"

            if trimmed.contains("func ") {
                apiType = "func"
                name = extractFunctionName(from: trimmed)
            } else if trimmed.contains("class ") {
                apiType = "class"
                name = extractTypeName(from: trimmed, keyword: "class ")
            } else if trimmed.contains("struct ") {
                apiType = "struct"
                name = extractTypeName(from: trimmed, keyword: "struct ")
            } else if trimmed.contains("enum ") {
                apiType = "enum"
                name = extractTypeName(from: trimmed, keyword: "enum ")
            } else if trimmed.contains("protocol ") {
                apiType = "protocol"
                name = extractTypeName(from: trimmed, keyword: "protocol ")
            } else if trimmed.contains("var ") || trimmed.contains("let ") {
                apiType = trimmed.contains("var ") ? "var" : "let"
                name = extractPropertyName(from: trimmed, keyword: apiType == "var" ? "var " : "let ")
            } else if trimmed.contains("init") {
                apiType = "init"
                name = "init"
            } else if trimmed.contains("typealias ") {
                apiType = "typealias"
                name = extractTypeName(from: trimmed, keyword: "typealias ")
            } else if trimmed.contains("subscript") {
                apiType = "subscript"
                name = "subscript"
            } else if trimmed.contains("actor ") {
                apiType = "actor"
                name = extractTypeName(from: trimmed, keyword: "actor ")
            }

            undocumented.append(UndocumentedAPI(
                file: relativePath,
                lineNumber: lineNumber,
                apiType: apiType,
                name: name,
                declaration: trimmed
            ))
        }
    }

    return (undocumented, totalPublic)
}

// MARK: - Output

func exportJSON(summary: [String: Any], undocumented: [UndocumentedAPI], to path: String) {
    let undocumentedJSON = undocumented.map { api -> [String: Any] in
        return [
            "file": api.file,
            "line": api.lineNumber,
            "type": api.apiType,
            "name": api.name,
            "declaration": api.declaration
        ]
    }

    let jsonOutput: [String: Any] = [
        "timestamp": ISO8601DateFormatter().string(from: Date()),
        "summary": summary,
        "undocumented_apis": undocumentedJSON
    ]

    if let jsonData = try? JSONSerialization.data(withJSONObject: jsonOutput, options: [.prettyPrinted, .sortedKeys]),
       let jsonString = String(data: jsonData, encoding: .utf8) {
        do {
            try jsonString.write(toFile: path, atomically: true, encoding: .utf8)
            print("📄 JSON exported to: \(path)")
        } catch {
            print("❌ Failed to write JSON: \(error.localizedDescription)")
        }
    }
}

// MARK: - Main

let config = Config.parse()

// Verify project exists
var isDir: ObjCBool = false
guard FileManager.default.fileExists(atPath: config.projectPath, isDirectory: &isDir), isDir.boolValue else {
    print("❌ Directory not found: \(config.projectPath)")
    exit(1)
}

print("📖 Swift Documentation Gap Analyzer")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("Project: \(config.projectPath)")
print("Sources: \(config.sourcesDir)")
print()

let sourceFiles = findSwiftFiles(in: config.sourcesDir)

if sourceFiles.isEmpty {
    print("⚠️  No Swift files found in \(config.sourcesDir)")
    exit(0)
}

print("Scanning \(sourceFiles.count) Swift files...")

var allUndocumented: [UndocumentedAPI] = []
var totalPublicAPIs = 0
var fileCount = 0

for sourceFile in sourceFiles {
    fileCount += 1
    if config.verbose && fileCount % 20 == 0 {
        print("  [\(fileCount)/\(sourceFiles.count)] Scanning...")
    }

    let (undocumented, publicCount) = analyzeFile(sourceFile, relativeTo: config.projectPath, verbose: config.verbose)
    allUndocumented.append(contentsOf: undocumented)
    totalPublicAPIs += publicCount
}

print()

// Results
let documented = totalPublicAPIs - allUndocumented.count
let coveragePercent = totalPublicAPIs > 0 ? Double(documented) / Double(totalPublicAPIs) * 100 : 100

print("📊 Results")
print("━━━━━━━━━━")
print("Total public APIs:    \(totalPublicAPIs)")
print("Documented:           \(documented) (\(String(format: "%.1f", coveragePercent))%)")
print("Undocumented:         \(allUndocumented.count) (\(String(format: "%.1f", 100 - coveragePercent))%)")
print()

if !allUndocumented.isEmpty {
    let byType = Dictionary(grouping: allUndocumented) { $0.apiType }
    let byFile = Dictionary(grouping: allUndocumented) { $0.file }

    print("By Type:")
    for (type, apis) in byType.sorted(by: { $0.value.count > $1.value.count }) {
        print("  \(type): \(apis.count)")
    }
    print()

    if config.verbose {
        print("Files with undocumented APIs:")
        for (file, apis) in byFile.sorted(by: { $0.value.count > $1.value.count }) {
            print("  \(file) (\(apis.count))")
            for api in apis {
                print("    L\(api.lineNumber): \(api.apiType) \(api.name)")
            }
        }
        print()
    } else {
        print("Top files needing documentation:")
        for (file, apis) in byFile.sorted(by: { $0.value.count > $1.value.count }).prefix(10) {
            print("  \(file) (\(apis.count) undocumented)")
        }
        print()
        print("Use --verbose to see all details")
    }
}

// JSON export
if let jsonPath = config.jsonOutput {
    let summary: [String: Any] = [
        "total_public_apis": totalPublicAPIs,
        "documented": documented,
        "undocumented": allUndocumented.count,
        "documentation_coverage_percent": coveragePercent,
        "by_type": Dictionary(grouping: allUndocumented) { $0.apiType }.mapValues { $0.count }
    ]
    exportJSON(summary: summary, undocumented: allUndocumented, to: jsonPath)
}

// Exit code based on coverage
if coveragePercent >= 99 {
    print("✅ Excellent documentation coverage!")
} else if coveragePercent >= 90 {
    print("👍 Good documentation coverage")
} else if coveragePercent >= 75 {
    print("⚠️  Documentation could be improved")
} else {
    print("❌ Documentation needs significant work")
}
